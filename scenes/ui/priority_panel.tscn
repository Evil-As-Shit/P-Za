layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "1 is done first, 4 last, blank never. Click to cycle, right-click to go back."

[node name="Grid" type="GridContainer" parent="Margin/Lines"]
unique_name_in_owner = true
layout_mode = 2
