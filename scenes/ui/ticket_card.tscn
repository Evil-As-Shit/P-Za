[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/ticket_card.gd" id="1_card"]

[node name="TicketCard" type="PanelContainer"]
mouse_default_cursor_shape = 6
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="Lines" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Title" type="Label" parent="Margin/Lines"]
unique_name_in_owner = true
layout_mode = 2
text = "#1 · Pizza"

[node name="Status" type="Label" parent="Margin/Lines"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Waiting"
