[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/ticket_rack_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://scenes/ui/ticket_column.tscn" id="2_column"]

[node name="TicketRackPanel" type="PanelContainer"]
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -300.0
grow_horizontal = 0
grow_vertical = 2
script = ExtResource("1_panel")

[node name="Margin" type="MarginContainer" parent="."]
