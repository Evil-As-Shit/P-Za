[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/world/world.gd" id="1_world"]
[ext_resource type="PackedScene" path="res://scenes/world/shop_floor.tscn" id="2_floor"]
[ext_resource type="PackedScene" path="res://scenes/pawns/pawn.tscn" id="3_pawn"]
[ext_resource type="Script" path="res://scripts/world/shop_camera.gd" id="4_camera"]

[node name="World" type="Node2D"]
script = ExtResource("1_world")

[node name="ShopFloor" parent="." instance=ExtResource("2_floor")]

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Pawn" parent="Entities" instance=ExtResource("3_pawn")]

[node name="ShopCamera" type="Camera2D" parent="."]
script = ExtResource("4_camera")
