[ext_resource type="Resource" path="res://resources/work_types/hauling.tres" id="2_work_type"]
[ext_resource type="Script" path="res://scripts/tasks/behaviors/haul_case_behavior.gd" id="3_behavior"]

[sub_resource type="Resource" id="Resource_behavior"]
