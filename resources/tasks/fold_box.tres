[gd_resource type="Resource" script_class="TaskType" format=3]

[ext_resource type="Resource" path="res://resources/work_types/box_folding.tres" id="9_work_type"]
[ext_resource type="Script" path="res://scripts/tasks/task_type.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/tasks/behaviors/fold_behavior.gd" id="2_behavior"]
[ext_resource type="Resource" path="res://resources/storage_kinds/flat_box.tres" id="3_flats"]
[ext_resource type="Resource" path="res://resources/storage_kinds/box.tres" id="4_boxes"]
[ext_resource type="Texture2D" path="res://resources/items/box/closed.tres" id="5_closed"]
[ext_resource type="Resource" path="res://resources/tasks/put_away_box.tres" id="6_put_away"]

[sub_resource type="Resource" id="Resource_behavior"]
script = ExtResource("2_behavior")
supply = ExtResource("3_flats")
stores = ExtResource("4_boxes")
finished_texture = ExtResource("5_closed")
