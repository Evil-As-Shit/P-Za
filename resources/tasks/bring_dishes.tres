[gd_resource type="Resource" script_class="TaskType" format=3]

[ext_resource type="Script" path="res://scripts/tasks/task_type.gd" id="1_task"]
[ext_resource type="Resource" path="res://resources/work_types/hauling.tres" id="2_work_type"]
[ext_resource type="Script" path="res://scripts/tasks/behaviors/bring_dishes_behavior.gd" id="3_behavior"]
[ext_resource type="Resource" path="res://resources/storage_kinds/empty_dishes.tres" id="4_empty"]
[ext_resource type="Resource" path="res://resources/items/dishes.tres" id="5_dishes"]

[sub_resource type="Resource" id="Resource_behavior"]
script = ExtResource("3_behavior")
empty_kind = ExtResource("4_empty")
dishes = ExtResource("5_dishes")

[resource]
script = ExtResource("1_task")
id = &"bring_dishes"
display_name = "Take dishes to the sink"
work_type = ExtResource("2_work_type")
work_minutes = 0.1
behavior = SubResource("Resource_behavior")
