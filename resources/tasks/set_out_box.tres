[gd_resource type="Resource" script_class="TaskType" format=3]

[ext_resource type="Resource" path="res://resources/work_types/hauling.tres" id="9_work_type"]
[ext_resource type="Script" path="res://scripts/tasks/task_type.gd" id="1_task"]
[ext_resource type="Texture2D" path="res://resources/items/box/open_back.tres" id="2_open_back"]
[ext_resource type="Texture2D" path="res://resources/items/box/open_front.tres" id="5_open_front"]
[ext_resource type="Resource" path="res://resources/storage_kinds/box.tres" id="3_box_kind"]
[ext_resource type="Script" path="res://scripts/tasks/behaviors/set_out_container_behavior.gd" id="4_behavior"]
[ext_resource type="Resource" path="res://resources/storage_kinds/flat_box.tres" id="6_flat_kind"]

[sub_resource type="Resource" id="Resource_behavior"]
script = ExtResource("4_behavior")
supply = ExtResource("3_box_kind")
fallback_supply = ExtResource("6_flat_kind")
fallback_extra_minutes = 0.4
open_under_texture = ExtResource("2_open_back")
open_over_texture = ExtResource("5_open_front")
