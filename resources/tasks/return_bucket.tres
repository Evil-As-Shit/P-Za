[gd_resource type="Resource" script_class="TaskType" format=3]

[ext_resource type="Script" path="res://scripts/tasks/task_type.gd" id="1_task"]
[ext_resource type="Resource" path="res://resources/work_types/hauling.tres" id="2_work_type"]
[ext_resource type="Script" path="res://scripts/tasks/behaviors/return_bucket_behavior.gd" id="3_behavior"]
[ext_resource type="Resource" path="res://resources/items/sauce_bucket.tres" id="4_sauce"]

[sub_resource type="Resource" id="Resource_behavior"]
script = ExtResource("3_behavior")
supply = ExtResource("4_sauce")

[resource]
script = ExtResource("1_task")
id = &"return_bucket"
display_name = "Put away a sauce bucket"
work_type = ExtResource("2_work_type")
work_minutes = 0.1
behavior = SubResource("Resource_behavior")
